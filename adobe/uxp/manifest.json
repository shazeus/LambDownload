{
  "manifestVersion": 5,
  "id": "com.shazeus.lambdownload",
  "name": "LambDownload",
  "version": "1.0.6",
  "main": "index.html",
  "host": [
    {
      "app": "PremierePro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "lambdownload-panel",
      "label": "LambDownload",
      "minimumSize": {
        "width": 640,
        "height": 520
      },
      "preferredDockedSize": {
        "width": 980,
        "height": 720
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1:4317", "http://localhost:4317", "https://api.github.com", "https://github.com"]
    },
    "localFileSystem": "fullAccess"
  }
}
